# Local development only. Copy this file to .env.local and use your vault path.
OBSIDIAN_VAULT_PATH="/absolute/path/to/your/obsidian/vault"

# Server-only authentication for https://chat.tomd.sh/v1.
CHAT_API_KEY=""

# Optional overrides for remote production syncs.
OBSIDIAN_VAULT_REPOSITORY="https://github.com/username/my-obsidian-vault.git"
OBSIDIAN_VAULT_REF="main"
