    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright": "^1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
