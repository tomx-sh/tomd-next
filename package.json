    "cn": "^0.5.2",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "gray-matter": "^4.0.3",
    "ironpress": "^1.7.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "postcss-logical": "^9.0.2",
    "postcss-nesting": "^14.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-floyd-steinberg": "github:tomx-sh/react-floyd-steinberg#v0.7.0",
