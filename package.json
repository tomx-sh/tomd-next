{
  "name": "tomd-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run prepare:chat && bun run sync-content:local && next dev",
    "build": "bun run prepare:chat && bun run sync-content:remote && next build",
    "prepare:chat": "bun scripts/prepare-chat.ts",
    "sync-content": "bun scripts/sync-obsidian-vault.ts --auto",
    "sync-content:local": "bun scripts/sync-obsidian-vault.ts --local",
    "sync-content:remote": "bun scripts/sync-obsidian-vault.ts --remote",
    "start": "next start",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "format": "biome format --write"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@shikijs/transformers": "^4.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chalk": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "gray-matter": "^4.0.3",
    "libfx": "0.0.13-dev.1512.ga8421a0ce13b",
    "lucide-react": "^1.56.0",
    "marked": "^15",
    "marked-terminal": "^7.3.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-floyd-steinberg": "github:tomx-sh/react-floyd-steinberg",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
